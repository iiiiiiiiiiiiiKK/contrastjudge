{
  "singleQuote": true,
  "printWidth": 118,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.json"],
      "options": { "printWidth": 120 }
    }
  ]
}
