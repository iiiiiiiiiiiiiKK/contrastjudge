# ContrastJudge needs no secrets, no API keys and no backend.
# This file documents the optional build-time settings only.

# Base path the built app is served from.
# GitHub Pages project site (default): /contrastjudge/
# Custom domain or any root-hosted deployment: /
VITE_BASE=/contrastjudge/

# Playwright (local test runs only — never shipped in the bundle)
# E2E_PORT=4591
# E2E_BASE_PATH=/contrastjudge/
# E2E_NO_SERVER=1
